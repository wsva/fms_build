{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!api|_next\\/static|_next\\/image|favicon.ico|manifest.webmanifest).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!api|_next/static|_next/image|favicon.ico|manifest.webmanifest).*)"
        }
      ]
    },
    "/api/card/sync/pull": {},
    "/api/card/sync/push": {},
    "/api/dataset/upload": {},
    "/api/v1/app/changes": {},
    "/api/v1/app/state": {},
    "/api/v1/changes": {},
    "/api/v1/cluster": {},
    "/api/v1/datasets": {},
    "/api/v1/datasets/[uuid]/changes": {},
    "/api/v1/datasets/[uuid]/manifest": {},
    "/api/v1/datasets/[uuid]/snapshot": {},
    "/api/v1/file": {},
    "/api/v1/inbox": {},
    "/api/v1/inbox/ack": {},
    "/api/v1/publish": {},
    "/api/v1/publish/availability": {},
    "/api/v1/registry/[uuid]/manifest": {},
    "/api/v1/registry/[uuid]/snapshot": {},
    "/api/v1/status": {},
    "/api/v1/sync/changes": {}
  }
}